# Copy to .env and adjust for your environment. Values below are safe
# local-dev defaults; NEVER reuse SECRET_KEY across environments.

SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DATABASE_ENGINE unset (or "sqlite") for local dev.
# Set DATABASE_ENGINE=postgres and fill in the rest for staging/production.
DATABASE_ENGINE=sqlite
DATABASE_NAME=ride_hailing
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Keycloak (identity provider) ---------------------------------------
# Server URL is the base Keycloak URL (no trailing /auth for Keycloak 17+).
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=ride-hailing
# Confidential client with "Direct Access Grants" enabled, used for
# /auth/login/ and /auth/refresh/.
KEYCLOAK_CLIENT_ID=ride-hailing-backend
KEYCLOAK_CLIENT_SECRET=change-me

# Used only for Admin API calls at registration time (creating a Keycloak
# user, assigning a realm role). Using the master-realm admin user is fine
# for local dev; use a dedicated service-account client in production.
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Redis (dispatch driver-location store) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Maps & Routing --------------------------------------------------------
# "osrm_nominatim" (default) needs no API key — uses the free public
# Nominatim/OSRM instances below. Point these at a self-hosted instance for
# any real production traffic; the public ones have strict rate limits and
# an acceptable-use policy (Nominatim requires a descriptive User-Agent).
MAP_PROVIDER=osrm_nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ride-hailing-platform-dev (set a real contact in production)
OSRM_BASE_URL=https://router.project-osrm.org

# Only needed if MAP_PROVIDER=google_maps
GOOGLE_MAPS_API_KEY=

# --- Payments ---------------------------------------------------------------
# Cash requires no configuration. Card/mobile-money need real merchant
# credentials from the respective provider before use.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_CALLBACK_URL=http://localhost:8000/api/v1/payments/webhooks/chapa/

# --- Driver Earnings & Wallet -----------------------------------------------
PLATFORM_COMMISSION_RATE=0.20
MINIMUM_PAYOUT_AMOUNT=10.00

# --- Celery (async task processing) -----------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# True runs tasks synchronously in-process — useful for quick local testing
# without a running worker; leave False for anything resembling production.
CELERY_TASK_ALWAYS_EAGER=False

# --- Notifications -----------------------------------------------------------
# Console backend prints emails to the runserver log — fine for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
